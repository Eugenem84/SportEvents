DATABASE_URL=postgres://postgres:postgres@localhost:5434/booking?sslmode=disable
APP_PORT=8082
POSTGRES_PORT=5434

# VK (Phase 4 — VK Adapter)
VK_GROUP_ID=
# VK_APP_ID — id мини-приложения (нужен команде «/приложение»: кнопка open_app).
VK_APP_ID=
# VK_APP_SECRET — защищённый ключ приложения: им проверяется подпись (sign)
# параметров запуска мини-приложения. Пусто — проверка пропускается (разработка).
VK_APP_SECRET=
VK_TOKEN=
VK_CONFIRMATION_TOKEN=
VK_SECRET=

